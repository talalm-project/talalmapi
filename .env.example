APP_ENV=development
SECRET_KEY=default-api-fast-secret
DB_NAME=default_api_fast
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Optional override if you want a full URI instead of components.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/default_api_fast_development

# RustFS/S3-compatible storage
STORAGE_MAX_CONTENT_LENGTH_MB=100

STORAGE_S3_BUCKET=talalm-local
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY_ID=rustfsadmin
STORAGE_S3_SECRET_ACCESS_KEY=rustfsadmin
STORAGE_S3_SESSION_TOKEN=
STORAGE_S3_PREFIX=
STORAGE_S3_PUBLIC_URL=http://localhost:9000/talalm-local
STORAGE_S3_PRESIGNED_EXPIRES_IN=3600
STORAGE_S3_ACL=
STORAGE_S3_SIGNATURE_VERSION=s3v4
STORAGE_S3_ADDRESSING_STYLE=path
STORAGE_S3_CREATE_BUCKET=true

# LaTeX compilation
LATEX_COMPILE_TIMEOUT_SECONDS=60
LATEX_TMP_ROOT=/tmp/papers
LATEX_DEFAULT_COMPILER=pdflatex

# Inference
INFERENCE_SYSTEM_PROMPT=You are a helpful assistant. Answer in Markdown. Keep the response complete and concise enough to fit within the configured maximum output tokens.
